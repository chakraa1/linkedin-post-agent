# ─── LLM Provider API Keys ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...             # Also used for DALL-E 3 image generation
PERPLEXITY_API_KEY=pplx-...       # Optional — enables real-time web research

# ─── Image Generation (choose one provider) ───────────────────────────────────
IMAGE_PROVIDER=openai             # openai | stability | replicate | none
# STABILITY_API_KEY=sk-...        # Stable Diffusion 3 — stability.ai
# REPLICATE_API_KEY=r8_...        # Flux Pro — replicate.com

# ─── LinkedIn OAuth 2.0 (from https://developer.linkedin.com) ─────────────────
# Create a LinkedIn Developer App, add "Sign In with LinkedIn" and "Share on LinkedIn"
# products, then set redirect URI: http://localhost:8080/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# After running `python main.py auth`, this is auto-populated:
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXX

# ─── Agent LLM Overrides (optional – overrides config/llm_config.yaml) ────────
# RESEARCH_AGENT_PROVIDER=perplexity
# RESEARCH_AGENT_MODEL=sonar-pro
# CONTENT_AGENT_PROVIDER=anthropic
# CONTENT_AGENT_MODEL=claude-sonnet-4-6

# ─── App Settings ─────────────────────────────────────────────────────────────
# Comma-separated topics to research (leave empty for auto-selection)
RESEARCH_TOPICS=
# Default audience focus
TARGET_AUDIENCE=Cloud Engineers, Platform Engineers, Architects, Product Engineering Leaders
